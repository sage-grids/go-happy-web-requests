PORT=8080
API_TOKEN=change_me_in_production
SERVICE_FQDN=go-happy-web-requests.example.com

# Auth fails closed: the server refuses to start unless API_TOKEN is set.
# Set AUTH_DISABLED=true to intentionally run without authentication.
# AUTH_DISABLED=false

# Safety limits (defaults shown)
# MAX_REQUEST_BYTES=1048576    # max inbound request body (1 MiB)
# MAX_RESPONSE_BYTES=10485760  # max bytes read from a target response (10 MiB)
# MAX_PROXIES=50               # max proxies raced per request
